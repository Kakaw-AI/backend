generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Better Auth required tables ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  accounts        Account[]
  databaseSources DatabaseSource[]
  llmConnections  LlmConnection[]
  conversations   Conversation[]
  agentRunTraces  AgentRunTrace[]
  tokenUsage      TokenUsageEntry[]

  @@map("users")
}

enum DatabaseSourceStatus {
  PENDING
  SYNCING
  READY
  FAILED
}

enum LlmConnectionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LlmProvider {
  OPENAI
  ANTHROPIC
  OPENROUTER
  GOOGLE
  OLLAMA
  LM_STUDIO
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

enum MessageArtifactType {
  TEXT
  SQL
  TABLE
  CHART
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

model DatabaseSource {
  id                   String               @id @default(cuid())
  provider             String
  name                 String?
  status               DatabaseSourceStatus @default(PENDING)
  connectionString     String?
  sqliteObjectKey      String?
  sqliteOriginalFilename String?
  sqliteFingerprint    String?
  schemaFingerprint    String?
  syncMetadata         Json?
  lastError            String?
  lastTestedAt         DateTime?
  lastSyncedAt         DateTime?
  syncRequestedAt      DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  userId             String
  user               User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  tables             DatabaseSourceTable[]
  agentRunTraces     AgentRunTrace[]
  queryMemoryEntries QueryMemoryEntry[]

  @@index([userId, sqliteFingerprint])
  @@map("database_sources")
}

enum QueryMemoryStatus {
  ACTIVE
  QUARANTINED
  RETIRED
}

/// A question this data source has already answered, paired with the SQL that
/// actually executed. Built from agent_run_traces, which recorded both all
/// along and was never read back.
///
/// Scoped by databaseSourceId, and DatabaseSource carries a userId, so tenant
/// isolation is structural rather than something the query has to remember.
model QueryMemoryEntry {
  id                 String            @id @default(cuid())
  schemaFingerprint  String
  question           String
  /// sha256(databaseSourceId \0 normalizedQuestion) — one entry per question,
  /// so re-asking and getting it right overwrites a bad entry.
  questionHash       String
  sql                String
  tablesReferenced   String[]
  /// 384-dim float32, L2-normalized. Null until the semantic tier ships.
  embedding          Bytes?
  embeddingModel     String?
  status             QueryMemoryStatus @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  databaseSourceId String
  databaseSource   DatabaseSource @relation(fields: [databaseSourceId], references: [id], onDelete: Cascade)

  @@unique([databaseSourceId, questionHash])
  @@index([databaseSourceId, status, schemaFingerprint])
  @@map("query_memory_entries")
}

model LlmConnection {
  id                String              @id @default(cuid())
  provider          LlmProvider
  status            LlmConnectionStatus @default(PENDING)
  displayName       String
  defaultModel      String
  encryptedApiKey   String?
  apiKeyLastFour    String?
  baseUrl           String?
  isActive          Boolean             @default(true)
  lastError         String?
  lastTestedAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  agentRunTraces AgentRunTrace[]

  @@index([userId])
  @@map("llm_connections")
}

model Conversation {
  id               String         @id @default(cuid())
  title            String
  lastMessageAt    DateTime?
  llmModelOverride String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  databaseSourceId String
  databaseSource   DatabaseSource @relation(fields: [databaseSourceId], references: [id], onDelete: Cascade)
  llmConnectionId  String?
  llmConnection    LlmConnection? @relation(fields: [llmConnectionId], references: [id], onDelete: SetNull)
  messages         Message[]
  agentRunTraces   AgentRunTrace[]

  // The conversation list sorts on lastMessageAt first.
  @@index([userId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String        @id @default(cuid())
  role           MessageRole
  status         MessageStatus @default(PENDING)
  content        String
  error          String?
  tokenUsage     Json?
  suggestions    String[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  artifacts      MessageArtifact[]
  agentRunTraces AgentRunTrace[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageArtifact {
  id         String              @id @default(cuid())
  type       MessageArtifactType
  payload    Json
  createdAt  DateTime            @default(now())

  messageId  String
  message    Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@map("message_artifacts")
}

model DatabaseSourceTable {
  id                String                 @id @default(cuid())
  schemaName        String?
  name              String
  rowCount          Int?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  databaseSourceId  String
  databaseSource    DatabaseSource         @relation(fields: [databaseSourceId], references: [id], onDelete: Cascade)
  columns           DatabaseSourceColumn[]
  outgoingRelations DatabaseSourceRelation[] @relation("source_table_relations")
  incomingRelations DatabaseSourceRelation[] @relation("target_table_relations")

  @@unique([databaseSourceId, schemaName, name])
  @@map("database_source_tables")
}

model DatabaseSourceColumn {
  id              String              @id @default(cuid())
  name            String
  dataType        String
  isNullable      Boolean
  isPrimaryKey    Boolean
  ordinalPosition Int
  sampleValues    Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tableId         String
  table           DatabaseSourceTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, name])
  @@index([tableId, ordinalPosition])
  @@map("database_source_columns")
}

model DatabaseSourceRelation {
  id             String              @id @default(cuid())
  sourceColumn   String
  targetColumn   String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  sourceTableId  String
  sourceTable    DatabaseSourceTable @relation("source_table_relations", fields: [sourceTableId], references: [id], onDelete: Cascade)
  targetTableId  String
  targetTable    DatabaseSourceTable @relation("target_table_relations", fields: [targetTableId], references: [id], onDelete: Cascade)

  @@index([sourceTableId])
  @@index([targetTableId])
  @@map("database_source_relations")
}

model AgentRunTrace {
  id               String         @id @default(cuid())
  question         String
  error            String?
  tokenUsage       Json?
  steps            Json?
  toolCalls        Json?
  repairHistory    Json?
  chartSpec        Json?
  cacheHit         Boolean        @default(false)
  createdAt        DateTime       @default(now())

  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  databaseSourceId String
  databaseSource   DatabaseSource @relation(fields: [databaseSourceId], references: [id], onDelete: Cascade)
  conversationId   String
  conversation     Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  llmConnectionId  String?
  llmConnection    LlmConnection? @relation(fields: [llmConnectionId], references: [id], onDelete: SetNull)
  messageId        String?
  message          Message?       @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, databaseSourceId, createdAt])
  @@index([conversationId, createdAt])
  // Every conversation load does a top-1 lookup per message on this relation.
  @@index([messageId, createdAt])
  // Query-memory backfill and per-source analytics scan by source alone, which
  // the userId-leading index above cannot serve.
  @@index([databaseSourceId, createdAt])
  // Deleting an LLM connection sets this to NULL on every trace.
  @@index([llmConnectionId])
  @@map("agent_run_traces")
}

/// Token usage per agent run, kept apart from the trace so it outlives deleted
/// chats and databases. Only the user cascade removes it. Holds no question,
/// answer or query text.
model TokenUsageEntry {
  id           String   @id @default(cuid())
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("token_usage_entries")
}
