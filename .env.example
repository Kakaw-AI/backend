# ── Infisical bootstrap (the ONLY secrets that stay in env in prod) ──────────
# When these are set, all variables below are fetched from Infisical at startup
# and injected into process.env. Leave them empty to fall back to this file.
INFISICAL_SITE_URL=https://hush.gitnasr.com
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# Optional. Defaults to "prod" when NODE_ENV=production, otherwise "dev".
INFISICAL_ENVIRONMENT=
# Optional. Defaults to "/".
INFISICAL_SECRET_PATH=/

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Pino log level (trace|debug|info|warn|error|fatal). Logs are JSON in prod,
# pretty-printed in dev.
LOG_LEVEL=info

# ── OpenTelemetry (traces + metrics + logs) ──────────────────────────────────
# Telemetry is OFF unless OTEL_EXPORTER_OTLP_ENDPOINT is set. The exporters
# append /v1/traces, /v1/metrics, /v1/logs to this base URL. Point it at the
# Alloy OTLP gateway. Leave empty for local dev to stay quiet.
OTEL_EXPORTER_OTLP_ENDPOINT=https://alloy.gitnasr.com
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=kakaw-backend
# Optional auth for the gateway, e.g. "Authorization=Basic <base64>".
OTEL_EXPORTER_OTLP_HEADERS=

# ── Managed by Infisical in prod/dev (documented here for local fallback) ────
DATABASE_URL=
BETTER_AUTH_SECRET=
# Public origin of THIS backend (used to build OAuth callback URLs). In prod
# this is the API subdomain, e.g. https://k-api.gitnasr.com — so the OAuth
# callbacks are https://k-api.gitnasr.com/api/auth/callback/{github,google}.
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public origin of the frontend (CORS origin + Better Auth trusted origin).
FRONTEND_URL=http://localhost:3000
# Shared parent domain for the session cookie when the API + frontend are on
# different subdomains of one site. Empty for local dev. Prod: .gitnasr.com
COOKIE_DOMAIN=
LLM_CONNECTIONS_ENCRYPTION_KEY=
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SHARED_SECRET=
BACKEND_INTERNAL_URL=http://localhost:3001/api/chat/internal

# ── Cloudflare R2 (SQLite object storage) ────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
